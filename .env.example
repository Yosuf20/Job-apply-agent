# LLM Provider Configuration
# Choose your active provider: "anthropic", "openai", or "gemini"
LLM_PROVIDER=anthropic

# API key for the chosen provider
LLM_API_KEY=

# Model name for fast / low-cost tasks (e.g. extraction, scoring)
# Examples:
#   Anthropic: claude-3-5-haiku-latest
#   OpenAI:    gpt-4o-mini
#   Gemini:    gemini-1.5-flash
LLM_MODEL_SMALL=

# Model name for complex reasoning and writing (e.g. resume tailoring, validation)
# Examples:
#   Anthropic: claude-3-5-sonnet-latest
#   OpenAI:    gpt-4o
#   Gemini:    gemini-1.5-pro
LLM_MODEL_STRONG=

# Request timeout in seconds for LLM API calls (default: 60)
LLM_TIMEOUT_SECONDS=60

# Application Data & Storage Paths
# Path to your master profile containing experience, projects, and skills
PROFILE_PATH=data/profile.yaml

# Directory where generated resumes, tailored outputs, and debug logs are saved
OUTPUT_DIR=data/output

# SQLite database path for persisting jobs, stages, and application tracking
DATABASE_PATH=data/tracker.db

# YAML file listing Greenhouse board tokens and discovery filters
SOURCES_PATH=data/sources.yaml
